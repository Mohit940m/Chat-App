							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/check",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"check"
							]
						}
					}
				}
			]
		},
		{
			"name": "Messages",
			"item": [
				{
					"name": "Get Users for Sidebar",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/messages/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"messages",
								"users"
							]
						}
					}
				},
				{
					"name": "Get Messages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/messages/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
